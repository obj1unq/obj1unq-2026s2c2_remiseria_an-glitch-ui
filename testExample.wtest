import vehiculos.*
import reserva.*
import chasquiCoop.*

describe "Combi adaptable" {
    //const combi = new CombiAdaptable()
    //method initialize() {
    //    
    //}

    test "comienza con interior accesible y motor urbano" {
        assert.equals("Celeste", combiAdaptable.color())
        assert.equals(5, combiAdaptable.capacidad())
        assert.equals(true, combiAdaptable.puedeTransportarSillaDeRuedas())
        assert.equals(130, combiAdaptable.velocidadMax())
        assert.equals(1000, combiAdaptable.autonomia())
        assert.equals(false, combiAdaptable.motorRuidoso())
    }

    test "permite cambiar a interior espacioso y motor deportivo" {
        combiAdaptable.interior(interiorEspacioso)
        combiAdaptable.motor(motorDeportivo)

        assert.equals(7, combiAdaptable.capacidad())
        assert.equals(false, combiAdaptable.puedeTransportarSillaDeRuedas())
        assert.equals(230, combiAdaptable.velocidadMax())
        assert.equals(400,combiAdaptable.autonomia())
        assert.equals(true, combiAdaptable.motorRuidoso())

        combiAdaptable.interior(interiorAccesible)
        combiAdaptable.motor(motorUrbano)
    }
}	

describe "Reserva" {
    test "cumple la reserva exigente con la combi" {
        const reserva = new Reserva()
        //const combi = new CombiAdaptable()
        reserva.cantPersonas(5)
        reserva.distanciaARecorrer(480)
        reserva.maxHorasDeViaje(4)
        reserva.necesitaAutoSilencioso(true)
        reserva.necesitaTransportarSillaDeRuedas(true)
        reserva.agregarColor("Rojo")
        reserva.agregarColor("Verde Fluor")

        assert.equals(true, reserva.puedeSerCumplidaPor(combiAdaptable))
    }

    test "falla si rey de copas no tiene capacidad suficiente" {
        const reserva = new Reserva()
        reserva.cantPersonas(5)
        reserva.distanciaARecorrer(200)
        reserva.maxHorasDeViaje(2)
        const reyDeCopas = new Torino()
        reyDeCopas.color("Rojo")
        reyDeCopas.autonomia(300)
        reyDeCopas.velocidadMax(120)

        assert.equals(false, reserva.puedeSerCumplidaPor(reyDeCopas))
    }

    test "falla si xeneize no tiene autonomia suficiente" {
        const reserva = new Reserva()
        reserva.cantPersonas(5)
        reserva.distanciaARecorrer(195)
        reserva.maxHorasDeViaje(2)
        const xeneize = new Economico()
        xeneize.tieneCañoDeEscapeSilencioso(true)

        assert.equals(false, reserva.puedeSerCumplidaPor(xeneize))
    }

    test "falla si millonario no alcanza la velocidad requerida" {
        const reserva = new Reserva()
        reserva.cantPersonas(5)
        reserva.distanciaARecorrer(200)
        reserva.maxHorasDeViaje(1)
        const millonario = new Economico()

        assert.equals(false, reserva.puedeSerCumplidaPor(millonario))
    }

    test "falla si rey de copas tiene un color contraindicado" {
        const reserva = new Reserva()
        reserva.cantPersonas(4)
        reserva.distanciaARecorrer(150)
        reserva.maxHorasDeViaje(1.5)
        reserva.agregarColor("Rojo")
        const reyDeCopas = new Torino()
        reyDeCopas.color("Rojo")
        reyDeCopas.autonomia(300)
        reyDeCopas.velocidadMax(120)

        assert.equals(false, reserva.puedeSerCumplidaPor(reyDeCopas))
    }

    test "falla si millonario no puede llevar silla de ruedas" {
        const reserva = new Reserva()
        reserva.cantPersonas(5)
        reserva.distanciaARecorrer(150)
        reserva.maxHorasDeViaje(1.5)
        reserva.necesitaTransportarSillaDeRuedas(true)
        const millonario = new Economico()

        assert.equals(false, reserva.puedeSerCumplidaPor(millonario))
    }

    test "falla si millonario es ruidoso y se necesita silencio" {
        const reserva = new Reserva()
        reserva.cantPersonas(5)
        reserva.distanciaARecorrer(150)
        reserva.maxHorasDeViaje(1.5)
        reserva.necesitaAutoSilencioso(true)
        const millonario = new Economico()

        assert.equals(false, reserva.puedeSerCumplidaPor(millonario))
    }

    test "villaElisa asigna correctamente sus reservas" {
        //const combi = new CombiAdaptable()
        const academia = new Torino()
        academia.color("Celeste")
        academia.autonomia(250)
        academia.velocidadMax(110)

        const reyDeCopas = new Torino()
        reyDeCopas.color("Rojo")
        reyDeCopas.autonomia(300)
        reyDeCopas.velocidadMax(120)

        const xeneize = new Economico()
        xeneize.tieneCañoDeEscapeSilencioso(true)

        chasquiCoop.agregarVehiculo(combiAdaptable)
        chasquiCoop.agregarVehiculo(academia)
        chasquiCoop.agregarVehiculo(reyDeCopas)

        const reservaUNQ = new Reserva()
        reservaUNQ.cantPersonas(4)
        reservaUNQ.distanciaARecorrer(30)
        reservaUNQ.maxHorasDeViaje(4)
        reservaUNQ.agregarColor("Rojo")

        assert.equals(2, (chasquiCoop.vehiculosCapacitadosPara(reservaUNQ)).size())
        assert.equals(true, (chasquiCoop.vehiculosCapacitadosPara(reservaUNQ)).contains(combiAdaptable))
        assert.equals(true, (chasquiCoop.vehiculosCapacitadosPara(reservaUNQ)).contains(academia))
        assert.equals(false, (chasquiCoop.vehiculosCapacitadosPara(reservaUNQ)).contains(reyDeCopas))
        assert.throwsException({ chasquiCoop.hacerReserva(reservaUNQ, reyDeCopas) })
        assert.throwsException({ chasquiCoop.hacerReserva(reservaUNQ, xeneize) })
        chasquiCoop.hacerReserva(reservaUNQ, combiAdaptable)

        const reservaUTN = new Reserva()
        reservaUTN.cantPersonas(4)
        reservaUTN.distanciaARecorrer(60)
        reservaUTN.maxHorasDeViaje(4)
        reservaUTN.necesitaAutoSilencioso(true)
        reservaUTN.necesitaTransportarSillaDeRuedas(true)
        chasquiCoop.hacerReserva(reservaUTN, combiAdaptable)

        const reservaUnsam = new Reserva()
        reservaUnsam.cantPersonas(4)
        reservaUnsam.distanciaARecorrer(70)
        reservaUnsam.maxHorasDeViaje(4)
        reservaUnsam.agregarColor("Rojo")
        chasquiCoop.hacerReserva(reservaUnsam, academia)

        assert.equals(combiAdaptable, reservaUNQ.auto())
        assert.equals(combiAdaptable, reservaUTN.auto())
        assert.equals(academia, reservaUnsam.auto())
        assert.equals([reservaUNQ, reservaUTN], chasquiCoop.reservasParaElVehiculo(combiAdaptable))
        assert.equals([reservaUnsam], chasquiCoop.reservasParaElVehiculo(academia))
        assert.equals(90, chasquiCoop.distanciaTotalRecorridaPara(combiAdaptable))
        assert.equals(70, chasquiCoop.distanciaTotalRecorridaPara(academia))
    }
}